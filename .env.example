AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
FASTMCP_TRANSPORT=http
# Use 127.0.0.1 for local dev; set to 0.0.0.0 when running in Docker
FASTMCP_HOST=127.0.0.1
FASTMCP_PORT=8000
LOG_LEVEL=INFO
AUDIT_BUFFER_SIZE=500
CACHE_TTL_PRESENCE=30
CACHE_TTL_USER=300
CACHE_TTL_TEAMS=600
CACHE_TTL_POLICIES=900
CACHE_TTL_CALLS=120
CACHE_TTL_INCIDENTS=300
CACHE_TTL_DEVICES=300
